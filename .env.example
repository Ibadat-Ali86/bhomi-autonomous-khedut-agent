# Optional local speech recognition. Uses the multilingual Whisper tiny model.
BHOMI_LOCAL_ASR=true
BHOMI_WHISPER_MODEL=tiny
# Optional Groq chat model. Add GROQ_API_KEY to your shell environment or
# .streamlit/secrets.toml; never commit the key.
GROQ_MODEL=openai/gpt-oss-20b
# Optional vision-capable Groq model used only after the user submits a crop photo.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
